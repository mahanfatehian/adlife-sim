{% extends "base.html.j2" %}
{% block main %}
<section class="g-error" aria-labelledby="g-error-title">
<div class="g-card g-error-card">
<h1 class="g-error-title" id="g-error-title">{{ tr("error.title") }}</h1>
<p class="g-error-text">{{ tr(error.key) }}</p>
<p class="g-error-code">{{ tr("common.error.code", code=bdi_id(error.status|string)) }}</p>
<p class="g-error-actions">
<a class="g-btn g-btn--primary" href="{{ error.back_href }}">{{ tr("error.back") }}</a>
</p>
</div>
</section>
{% endblock %}
