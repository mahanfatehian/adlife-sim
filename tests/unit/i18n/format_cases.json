  "schema_version": 1,
  "description": "Shared number, time and plural formatting cases. Python (adlife.i18n) and JavaScript (guide-i18n.js) must both return every expected string. The per-language messages are injected test catalogs, so the cases do not depend on the translated de and fa catalogs; the en messages equal the packaged en.json.",
  "messages": {
    "en": {
      "common.day_clock": "Day {day} · {time}",
      "common.minutes_seconds": "{minutes} min {seconds} s",
      "common.percent": "{value}%",
      "common.seconds": {"one": "{count} second", "other": "{count} seconds"},
      "test.answered": "{resolved} of {total} answered",
      "test.plural": {"one": "one", "other": "other"}
    },
    "de": {
      "common.day_clock": "Tag {day} · {time}",
      "common.minutes_seconds": "{minutes} Min. {seconds} s",
      "common.percent": "{value} %",
      "common.seconds": {"one": "{count} Sekunde", "other": "{count} Sekunden"},
      "test.answered": "{resolved} von {total} beantwortet",
      "test.plural": {"one": "one", "other": "other"}
    },
    "fa": {
      "common.day_clock": "روز {day} · {time}",
      "common.minutes_seconds": "{minutes} دقیقه و {seconds} ثانیه",
      "common.percent": "{value}٪",
      "common.seconds": {"one": "{count} ثانیه", "other": "{count} ثانیه"},
      "test.answered": "{resolved} از {total} پاسخ داده شد",
      "test.plural": {"one": "one", "other": "other"}
    }
